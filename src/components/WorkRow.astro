---
export interface Props {
  num: string;
  name: string;
  italic: string;
  tags: string[];
  year: string;
  thumb: string;
  thumbMeta: string;
  href?: string;
  video?: string;
  image?: string;
}

const { num, name, italic, tags, year, thumb, thumbMeta, href = '#', video, image } = Astro.props;
const external = href.startsWith('http');
---

<a href={href} class="work-row tappable" data-thumb={thumb} data-thumb-meta={thumbMeta}
   data-video={video ?? ''}
   data-image={image ?? ''}
   {...external ? { target: '_blank', rel: 'noopener noreferrer' } : {}}>
  <span class="num">{num}</span>
  <span class="name">
    {name} <span class="italic">— {italic}</span>
  </span>
  <span class="tags">
    {tags.map((t) => <span class="tag">{t}</span>)}
  </span>
  <span class="yr">'{year}</span>
  <span class="arrow">
    <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
      <path d="M3 11L11 3M11 3H4M11 3V10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    </svg>
  </span>
</a>
