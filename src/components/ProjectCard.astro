---
/**
 * Visible project card for the home grid — the work page keeps the hover-row
 * treatment, but on the landing page the work should be on screen without
 * anyone having to discover a hover.
 *
 * Media is optional: a project with nothing shot yet gets a styled placeholder
 * rather than a broken frame.
 */
export interface Props {
  num: string;
  name: string;
  italic: string;
  tags: string[];
  year: string;
  href?: string;
  image?: string;
  video?: string;
  alt?: string;
  note?: string;
}

const {
  num, name, italic, tags, year,
  href = '#', image, video, alt = '', note,
} = Astro.props;

const external = href.startsWith('http');
const hasMedia = Boolean(image || video);
---

<a
  href={href}
  class="pcard tappable"
  {...external ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
>
  <div class="pcard-media" data-parallax-media>
    {video ? (
      <video src={video} muted loop playsinline preload="none" aria-hidden="true"></video>
    ) : image ? (
      <img src={image} alt={alt} loading="lazy" decoding="async" />
    ) : (
      <div class="pcard-placeholder" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="30" height="30"><use href="#logo-at"/></svg>
        <span>{note ?? 'Shots coming'}</span>
      </div>
    )}
    <span class="pcard-num">{num}</span>
    {!hasMedia && <span class="pcard-flag">no capture yet</span>}
  </div>

  <div class="pcard-body">
    <h4 class="pcard-name">
      {name} <span class="italic">— {italic}</span>
    </h4>
    <div class="pcard-foot">
      <span class="pcard-tags">
        {tags.map((t) => <span class="tag">{t}</span>)}
      </span>
      <span class="pcard-yr">'{year}</span>
    </div>
    <span class="pcard-arrow" aria-hidden="true">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
        <path d="M3 11L11 3M11 3H4M11 3V10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
    </span>
  </div>
</a>
